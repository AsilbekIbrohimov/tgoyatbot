# Namuna .env — nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring
# (.env git'ga yuklanmaydi)

# @BotFather bergan bot tokeni (MAJBURIY)
BOT_TOKEN=123456:AA...your-token...

# Admin Telegram ID lari (vergul bilan)
ADMINS=1024522810

# Bot ID lari (feedback/echo uchun; odatda o'zgartirilmaydi)
BOT_ID=5268428809

# Fikr-mulohaza yuboriladigan yopiq guruh ID si
TELEGRAM_SUPPORT_CHAT_ID=-1001772344700

# Admin panel paroli
ADMIN_PASSWORD=change-me

# Mini App manzili (GitHub Pages yoki o'zingizniki)
WEBAPP_URL=https://asilbekibrohimov.github.io/oyatbot/webapp/

# Mini App admin backend porti va yoqilishi
WEBAPP_API_PORT=8080
WEBAPP_API_ENABLED=true
